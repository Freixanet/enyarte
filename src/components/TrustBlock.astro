---
import type { Locale } from '../i18n';
import { pathFor, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = [
  { key: 'trust.certificate', icon: 'M3 8.5 6.5 12 13 4.5' },
  { key: 'trust.shipping', icon: 'M1.5 4.5h8v7h-8zM9.5 7h3l2 2v2.5h-5' },
  { key: 'trust.returns', icon: 'M13 8a5 5 0 1 1-2-4M11 2.5h2.5V5' },
  { key: 'trust.payment', icon: 'M4 7.5h8v6H4zM6 7.5V5a2 2 0 0 1 4 0v2.5' },
];
---

<aside class="trust">
  <ul class="trust__list">
    {items.map((item) => (
      <li class="trust__item">
        <svg class="trust__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d={item.icon}
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>{t(item.key, locale)}</span>
      </li>
    ))}
  </ul>
  <a class="trust__link" href={pathFor('purchaseFaq', locale)}>{t('trust.linkLabel', locale)}</a>
</aside>

<style>
  .trust {
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background-color: var(--c-paper);
    padding: var(--sp-4);
    margin-block: var(--sp-5);
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .trust__item {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .trust__icon {
    flex-shrink: 0;
    width: var(--sp-3);
    height: var(--sp-3);
    color: var(--c-earth);
  }

  .trust__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block-start: var(--sp-2);
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    color: var(--c-ink-2);
  }

  .trust__link:hover,
  .trust__link:focus-visible {
    color: var(--c-ink);
  }
</style>
