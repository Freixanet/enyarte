---
import type { Locale } from '../i18n';
import { absoluteUrl, pathFor, t } from '../i18n';
import { WEB3FORMS_ACCESS_KEY, WEB3FORMS_ENDPOINT } from '../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const redirect = absoluteUrl(pathFor('thankYou', locale));
---

<form class="form" action={WEB3FORMS_ENDPOINT} method="POST">
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="hidden" name="subject" value={t('meta.contact.title', locale)} />
  <input type="hidden" name="form_type" value="contact" />
  <label class="form__honeypot">
    {t('forms.honeypotLabel', locale)}
    <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
  </label>
  <div class="form__field">
    <label class="form__label" for="contact-name">{t('forms.name', locale)}</label>
    <input class="form__input" id="contact-name" name="name" type="text" required autocomplete="name" />
  </div>
  <div class="form__field">
    <label class="form__label" for="contact-email">{t('forms.email', locale)}</label>
    <input class="form__input" id="contact-email" name="email" type="email" required autocomplete="email" />
  </div>
  <div class="form__field">
    <label class="form__label" for="contact-message">{t('forms.message', locale)}</label>
    <textarea class="form__textarea" id="contact-message" name="message" rows="6" required></textarea>
  </div>
  <button class="form__submit" type="submit">{t('forms.submitContact', locale)}</button>
</form>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .form__field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .form__label {
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    color: var(--c-ink-2);
  }

  .form__input,
  .form__textarea,
  .form__select {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    color: var(--c-ink);
    background-color: var(--c-bone);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-3);
    min-height: 44px;
  }

  .form__textarea {
    min-height: calc(var(--sp-8) + var(--sp-4));
    resize: vertical;
  }

  .form__input:focus-visible,
  .form__textarea:focus-visible,
  .form__select:focus-visible {
    outline: 2px solid var(--c-ink);
    outline-offset: 2px;
  }

  .form__submit {
    align-self: flex-start;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--c-cta);
    border-radius: var(--radius);
    background-color: var(--c-cta);
    color: var(--c-bone);
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease-fn);
  }

  .form__submit:hover,
  .form__submit:focus-visible {
    background-color: var(--c-cta-hover);
    border-color: var(--c-cta-hover);
  }
</style>
