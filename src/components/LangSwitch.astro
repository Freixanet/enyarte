---
import type { Locale } from '../i18n';

interface Props {
  href: string;
  label: string;
  locale: Locale;
}

const { href, label, locale } = Astro.props;
const langTarget = locale === 'es' ? 'en' : 'es';
---

<a class="lang-switch" href={href} hreflang={langTarget} lang={langTarget} rel="alternate">
  {label}
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    color: var(--c-ink);
    text-decoration: none;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 0 var(--sp-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    border-color: var(--c-ink-2);
    color: var(--c-cta);
  }
</style>
