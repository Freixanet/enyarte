---
// Firma "fractura de vidrio" (§6.2): trazo SVG decorativo que se dibuja desde
// una esquina del MARCO en hover (desktop + pointer:fine). Es puramente
// decorativo (aria-hidden): el contenido de la card vive en .work-card__caption.
// No toca la imagen (§6.3). CSS declarativo, sin JS ni GSAP.
---

<div class="glass-fracture" aria-hidden="true">
  <svg class="glass-fracture__svg" viewBox="0 0 100 125" focusable="false">
    <path class="glass-fracture__path" pathLength="1" d="M0 0 L34 22 L23 55" />
    <path class="glass-fracture__path" pathLength="1" d="M0 0 L15 41" />
    <path class="glass-fracture__path" pathLength="1" d="M34 22 L62 31" />
  </svg>
</div>

<style is:global>
  .glass-fracture {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
    z-index: 1;
  }

  .glass-fracture__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* pathLength="1" normaliza cada trazo a longitud 1: dasharray/offset 1 lo
     oculta por completo en reposo y se "dibuja" al llevar offset a 0. No se usa
     non-scaling-stroke porque forzaría el patrón a px de pantalla y rompería la
     normalización (trazo visible en reposo). El viewBox 100×125 ya coincide con
     el aspect 4/5 del marco, así el escalado es uniforme y el stroke queda ~1px. */
  .glass-fracture__path {
    fill: none;
    stroke: var(--c-line);
    stroke-width: 0.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-el) var(--ease-fn);
  }

  @media (pointer: fine) {
    .glass-fracture {
      display: block;
    }

    .work-card__link:hover .glass-fracture__path,
    .work-card__link:focus-visible .glass-fracture__path {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-fracture {
      display: none;
    }
  }
</style>
