---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CommissionForm from '../components/CommissionForm.astro';
import { t } from '../i18n';

const locale = 'es';
const works = await getCollection('works');
const refMap = Object.fromEntries(works.map((work) => [work.slug, work.data.title]));

const steps = [
  { title: t('commissionsPage.step1Title', locale), text: t('commissionsPage.step1Text', locale) },
  { title: t('commissionsPage.step2Title', locale), text: t('commissionsPage.step2Text', locale) },
  { title: t('commissionsPage.step3Title', locale), text: t('commissionsPage.step3Text', locale) },
];
---

<Base locale={locale} pageKey="commissions">
  <div class="page content">
    <h1 class="page__heading">{t('pages.commissions.heading', locale)}</h1>
    <p class="page__intro">{t('commissionsPage.intro', locale)}</p>

    <section class="content__section">
      <h2 class="content__title">{t('commissionsPage.processTitle', locale)}</h2>
      <ol class="steps">
        {steps.map((step) => (
          <li class="steps__item">
            <h3 class="steps__title">{step.title}</h3>
            <p class="steps__text">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- PROVISIONAL: revisar con Enya -->
    <section class="content__section content__note">
      <p class="content__meta">{t('commissionsPage.fromPrice', locale)}</p>
      <p class="content__meta">{t('commissionsPage.typicalTimeline', locale)}</p>
    </section>

    <!-- F7: SHOW_COMMISSION_CASES when client provides photos -->
    <section class="content__section" hidden data-commission-cases>
      <h2 class="content__title">{t('commissionsPage.casesTitle', locale)}</h2>
      <p class="content__text">{t('commissionsPage.casesPlaceholder', locale)}</p>
    </section>

    <section class="content__section">
      <CommissionForm locale={locale} refMap={refMap} />
    </section>
  </div>
</Base>

<style>
  .content__section {
    margin-block-start: var(--sp-6);
  }

  .content__title {
    font-family: var(--f-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-block-end: var(--sp-4);
  }

  .content__text,
  .content__meta {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
  }

  .content__note {
    padding: var(--sp-4);
    background-color: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }

  .steps__title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-block-end: var(--sp-2);
  }

  .steps__text {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
  }
</style>
