---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaButton from '../../components/CtaButton.astro';
import WorkCard from '../../components/WorkCard.astro';
import WorkFilters from '../../components/WorkFilters.astro';
import { pathFor, t } from '../../i18n';

const locale = 'es';
const works = (await getCollection('works')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);

const narrativeLabels = {
  toNarrative: t('narrative.toNarrative', locale),
  toCatalog: t('narrative.toCatalog', locale),
  cuba: t('narrative.seriesCuba', locale),
  miami: t('narrative.seriesMiami', locale),
  sf: t('narrative.seriesSf', locale),
  roma: t('narrative.seriesRoma', locale),
  espana: t('narrative.seriesEspana', locale),
  none: t('narrative.seriesNone', locale),
};
---

<Base locale={locale} pageKey="works">
  <div class="page" data-works>
    <div class="works__head">
      <h1 class="page__heading">{t('pages.works.heading', locale)}</h1>
      <button
        type="button"
        class="works__toggle"
        data-narrative-toggle
        data-labels={JSON.stringify(narrativeLabels)}
        aria-pressed="false"
        hidden
      >
        {t('narrative.toNarrative', locale)}
      </button>
    </div>
    <WorkFilters locale={locale} basePath={pathFor('works', locale)} />
    <ul class="works-grid" data-grid>
      {works.map((work) => <WorkCard work={work} locale={locale} />)}
    </ul>
    <div class="travesia" data-travesia hidden></div>
    <div class="works-empty" data-filter-empty hidden>
      <p class="works-empty__text">{t('filters.empty', locale)}</p>
      <CtaButton variant="secondary" href={pathFor('commissions', locale)}>
        {t('filters.emptyCta', locale)}
      </CtaButton>
    </div>
  </div>
</Base>

<style>
  .works__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .works__toggle {
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    min-height: 44px;
    padding-inline: var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background-color: transparent;
    color: var(--c-ink);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-fn);
  }

  .works__toggle:hover {
    border-color: var(--c-cta);
  }

  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }

  @media (min-width: 48rem) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .works-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .works-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding-block: var(--sp-6);
  }

  .works-empty__text {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
  }
</style>
