---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const locale = 'es';
const { work } = Astro.props;
const workTitle = `${work.data.title} (${work.data.year})`;
---

<Base
  locale={locale}
  pageKey="works"
  title={workTitle}
  description={t('meta.work.description', locale)}
  slug={work.slug}
>
  <article class="page work">
    <h1 class="work__title">{work.data.title}</h1>
    <p class="work__year">{work.data.year}</p>
    <p class="work__technique">{work.data.technique_es}</p>
    <Image class="work__cover" src={work.data.cover} alt={work.data.title} />
  </article>
</Base>

<style>
  .work__title {
    font-family: var(--f-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-bottom: var(--sp-2);
  }

  .work__year,
  .work__technique {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
    margin-bottom: var(--sp-2);
  }

  .work__cover {
    margin-top: var(--sp-4);
    max-width: 100%;
    height: auto;
  }
</style>
