---
import Base from '../layouts/Base.astro';
import { pathFor, t } from '../i18n';

const locale = 'es';
---

<Base locale={locale} pageKey="thankYou">
  <div class="page content">
    <h1 class="page__heading">{t('pages.thankYou.heading', locale)}</h1>
    <p class="page__intro">{t('pages.thankYou.message', locale)}</p>
    <p class="content__link">
      <a href={pathFor('home', locale)}>{t('pages.thankYou.backHome', locale)}</a>
    </p>
  </div>
</Base>

<style>
  .content__link {
    margin-block-start: var(--sp-4);
    font-family: var(--f-ui);
    font-size: var(--fs-body);
  }

  .content__link a {
    color: var(--c-cta);
    text-decoration: none;
  }

  .content__link a:hover,
  .content__link a:focus-visible {
    color: var(--c-cta-hover);
  }
</style>
