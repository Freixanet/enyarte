---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';

const locale = 'en';

const exhibitions = [
  {
    year: 2024,
    title: 'Archive in Transit',
    venue: 'Provisional space',
    city: 'Madrid',
    type: 'group' as const,
    provisional: true,
  },
];
---

<Base locale={locale} pageKey="exhibitions">
  <div class="page content">
    <h1 class="page__heading">{t('pages.exhibitions.heading', locale)}</h1>
    <p class="page__intro">{t('pages.exhibitions.intro', locale)}</p>
    <ol class="timeline">
      {exhibitions.map((item) => (
        <li class="timeline__item">
          <p class="timeline__year">{item.year}</p>
          <div class="timeline__body">
            <h2 class="timeline__title">{item.title}</h2>
            <p class="timeline__meta">{item.venue} · {item.city}</p>
            <p class="timeline__type">
              {item.type === 'solo' ? t('exhibitionsPage.typeSolo', locale) : t('exhibitionsPage.typeGroup', locale)}
            </p>
            {item.provisional && (
              <!-- PROVISIONAL: revisar con Enya -->
              <p class="timeline__note">{t('exhibitionsPage.provisionalNote', locale)}</p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .timeline {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .timeline__item {
    display: grid;
    gap: var(--sp-2);
    padding-block-end: var(--sp-4);
    border-block-end: 1px solid var(--c-line);
  }

  @media (min-width: 48rem) {
    .timeline__item {
      grid-template-columns: var(--sp-7) 1fr;
      gap: var(--sp-4);
    }
  }

  .timeline__year {
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    color: var(--c-ink-2);
  }

  .timeline__title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-block-end: var(--sp-1);
  }

  .timeline__meta,
  .timeline__type,
  .timeline__note {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
  }
</style>
