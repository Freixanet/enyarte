---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../config';
import { t } from '../i18n';

const locale = 'es';
const downloads = [
  { label: t('pressPage.downloadCv', locale), href: '/press/cv.pdf' },
  { label: t('pressPage.downloadStatement', locale), href: '/press/statement.pdf' },
  { label: t('pressPage.downloadPhotos', locale), href: '/press/images/' },
];
---

<Base locale={locale} pageKey="press">
  <div class="page content">
    <h1 class="page__heading">{t('pages.press.heading', locale)}</h1>
    <p class="page__intro">{t('pages.press.intro', locale)}</p>

    <section class="content__section">
      <h2 class="content__title">{t('pressPage.bioShortTitle', locale)}</h2>
      <p class="content__text">{t('pressPage.bioShort', locale)}</p>
    </section>

    <section class="content__section">
      <h2 class="content__title">{t('pressPage.bioMediumTitle', locale)}</h2>
      <p class="content__text">{t('pressPage.bioMedium', locale)}</p>
    </section>

    <section class="content__section">
      <h2 class="content__title">{t('pressPage.bioLongTitle', locale)}</h2>
      <p class="content__text">{t('pressPage.bioLong', locale)}</p>
    </section>

    <section class="content__section">
      <h2 class="content__title">{t('pressPage.downloadsTitle', locale)}</h2>
      <ul class="downloads">
        {downloads.map((item) => (
          <li class="downloads__item">
            <span class="downloads__label">{item.label}</span>
            <span class="downloads__path">{item.href}</span>
            <!-- F7: enable download links when assets are ready -->
            <span class="downloads__soon">{t('pressPage.comingSoon', locale)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="content__section">
      <h2 class="content__title">{t('pressPage.contactTitle', locale)}</h2>
      <p class="content__text">{t('pressPage.contactText', locale)}</p>
      <p class="content__text">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .content__section {
    margin-block-start: var(--sp-6);
  }

  .content__title {
    font-family: var(--f-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-block-end: var(--sp-3);
  }

  .content__text {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-2);
  }

  .content__text a {
    color: var(--c-cta);
    text-decoration: none;
  }

  .downloads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .downloads__item {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background-color: var(--c-paper);
  }

  .downloads__label {
    font-family: var(--f-ui);
    font-size: var(--fs-body);
    color: var(--c-ink);
  }

  .downloads__path,
  .downloads__soon {
    font-family: var(--f-ui);
    font-size: var(--fs-meta);
    color: var(--c-ink-2);
  }
</style>
