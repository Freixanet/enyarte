---
import Base from '../layouts/Base.astro';
import { getLocale, pathFor, t } from '../i18n';

const locale = getLocale(Astro.url.pathname);
const worksHref = pathFor('works', locale);
---

<Base locale={locale} pageKey="notFound">
  <div class="page">
    <h1 class="page__heading">{t('pages.notFound.heading', locale)}</h1>
    <p class="page__intro">{t('pages.notFound.intro', locale)}</p>
    <p class="page__intro">
      <a class="not-found__link" href={worksHref}>{t('pages.notFound.linkWorks', locale)}</a>
    </p>
  </div>
</Base>

<style>
  .not-found__link {
    color: var(--c-cta);
    text-decoration: none;
  }

  .not-found__link:hover,
  .not-found__link:focus-visible {
    color: var(--c-cta-hover);
  }
</style>
